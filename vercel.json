{
  "redirects": [
    {
      "source": "/",
      "destination": "/th",
      "permanent": true
    },
    {
      "source": "/:section(projects|timeline|uses)",
      "destination": "/th/:section",
      "permanent": false
    },
    {
      "source": "/:section(projects|timeline)/:path*",
      "destination": "/th/:section/:path*",
      "permanent": false
    }
  ]
}
